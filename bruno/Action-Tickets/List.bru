meta {
  name: List Action Tickets
  type: http
  seq: 2
}

docs {
  Lists action tickets for the authenticated user. Requires a valid bearer token; the successful response contains the user's tickets, or an empty list when none exist.
}

get {
  url: {{baseUrl}}/api/action-tickets
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}