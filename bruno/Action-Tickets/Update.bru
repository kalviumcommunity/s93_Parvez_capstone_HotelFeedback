meta {
  name: Update Action Ticket
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/action-tickets/{{actionTicketId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "In Progress",
    "priority": "Urgent",
    "assignedTo": "Duty Manager"
  }
}