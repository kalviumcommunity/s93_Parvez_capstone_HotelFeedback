meta {
  name: Register
  type: http
  seq: 1
}

docs {
  Creates a local account using the configured username and password. On success, the response contains the new user and a session token, which this request saves to the Local environment for protected requests.
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.data?.token) {
    bru.setEnvVar("token", res.body.data.token);
  }
}