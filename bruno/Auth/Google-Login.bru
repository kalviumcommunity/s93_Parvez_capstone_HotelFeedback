meta {
  name: Google Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/google
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "credential": "{{googleCredential}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body?.data?.token) {
    bru.setEnvVar("token", res.body.data.token);
  }
}