meta {
  name: Google Login
  type: http
  seq: 3
}

docs {
  Exchanges a valid Google Identity Services ID token for an app session. Requires GOOGLE_CLIENT_ID on the server and a real ID token in the Local environment; a successful response saves the app token for protected requests.
}

post {
  url: {{baseUrl}}/api/auth/google
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "credential": "{{googleCredential}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body?.data?.token) {
    bru.setEnvVar("token", res.body.data.token);
  }
}