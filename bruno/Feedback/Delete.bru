meta {
  name: Delete Feedback
  type: http
  seq: 7
}

docs {
  Deletes the selected feedback record and any stored attachment. Requires a valid bearer token and an existing feedback ID; run after any retrieval or download steps that need the record.
}

delete {
  url: {{baseUrl}}/api/feedback/{{feedbackId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}