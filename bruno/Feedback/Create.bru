meta {
  name: Create Feedback
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/feedback
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "guestName": "Taylor Guest",
    "source": "Internal Survey",
    "rating": 5,
    "comment": "The room was ready early and the staff were very helpful.",
    "sentiment": "Positive",
    "departmentTag": "Front Desk"
  }
}