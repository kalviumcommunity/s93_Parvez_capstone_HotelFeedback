meta {
  name: Create Feedback With Attachment
  type: http
  seq: 2
}

docs {
  Creates feedback with the included PNG data URL. Requires a valid bearer token; the API validates file type, content signature, and the 5 MB limit, then returns the saved record and attachment metadata.
}

post {
  url: {{baseUrl}}/api/feedback
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "guestName": "Taylor Guest",
    "source": "Internal Survey",
    "rating": 4,
    "comment": "Attached is a receipt for the minibar charge.",
    "sentiment": "Positive",
    "departmentTag": "General",
    "attachment": {
      "fileName": "receipt.png",
      "data": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+/pZ8AAAAASUVORK5CYII="
    }
  }
}