meta {
  name: Update Feedback
  type: http
  seq: 6
}

docs {
  Updates the selected feedback rating, comment, and sentiment. Requires a valid bearer token and an existing feedback ID in the Local environment; use the ID returned by Create Feedback.
}

put {
  url: {{baseUrl}}/api/feedback/{{feedbackId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "rating": 4,
    "comment": "The room was comfortable and the staff were helpful.",
    "sentiment": "Positive"
  }
}